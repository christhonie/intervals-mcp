{
  "name": "intervals-mcp",
  "version": "0.1.17",
  "private": true,
  "description": "Remote (Streamable HTTP) Model Context Protocol server for the Intervals.icu training API, built for claude.ai custom connectors. Adds coaching-specific tools (load rules, readiness flags, week-row notes, Plan Builder integration) on top of the Intervals.icu API.",
  "main": "dist/http-server.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "node dist/http-server.js",
    "start:stdio": "node dist/index.js",
    "clean": "rm -rf dist",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "inspect": "npm run build && npx @modelcontextprotocol/inspector@latest node --env-file .env dist/index.js"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "intervals.icu",
    "cycling",
    "training",
    "claude",
    "remote",
    "http"
  ],
  "author": "Christhonie Geldenhuys",
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.27.0",
    "express": "^4.21.2",
    "ioredis": "^5.11.0",
    "jstat": "^1.9.6",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.0.0",
    "typescript": "~5.7.0",
    "vitest": "^4.1.8"
  },
  "bin": {
    "intervals-mcp-server": "dist/http-server.js",
    "intervals-mcp-stdio": "dist/index.js"
  },
  "files": [
    "dist/",
    "README.md",
    "LICENSE"
  ]
}
