# Intervals.icu MCP — environment configuration
# Copy to .env for local development (never commit .env).

# --- Upstream Intervals.icu API ---
# Personal API key from intervals.icu → Settings → Developer.
# Auth is HTTP Basic with the literal username "API_KEY" and this value as the password.
INTERVALS_API_KEY=

# Athlete ID, i-prefixed (e.g. i579914). "0" resolves to the authenticated athlete on GETs.
INTERVALS_ATHLETE_ID=i579914

# Optional override (defaults to https://intervals.icu)
# INTERVALS_BASE_URL=https://intervals.icu

# --- OAuth 2.1 (claude.ai custom-connector auth) ---
# Only required for the remote HTTP transport (dist/http-server.js).
# These are the credentials you enter in claude.ai → Connectors → Advanced settings.
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=

# Public issuer URL of this deployment (used to build OAuth discovery metadata).
# OAUTH_ISSUER_URL=https://icu-mcp.christhonie.co.za

# Comma-separated exact-match redirect URIs (defaults cover claude.ai + localhost).
# OAUTH_REDIRECT_URIS=https://claude.ai/api/mcp/auth_callback,https://claude.com/api/mcp/auth_callback,http://localhost:3000/callback

# --- HTTP server ---
# PORT=8000
# HOST=0.0.0.0

# --- OAuth state persistence (optional) ---
# When set, OAuth codes/tokens are stored in Redis so they survive pod rollouts
# (claude.ai is not forced to re-authenticate after a deploy). Unset = in-memory.
# Use an app-unique DB or key prefix when sharing one Redis across MCP servers.
# REDIS_URL=redis://:<password>@idealogic-prod-redis-master.redis.svc.cluster.local:6379/3
